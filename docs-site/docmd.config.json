{
  "title": "claude-mem-sync",
  "description": "Team memory sharing for claude-mem: sync AI memories across developers via Git.",
  "url": "https://doc.claude-mem-sync.padosoft.com",
  "src": "docs",
  "out": "_site",
  "base": "/",
  "theme": {
    "customCss": [
      "assets/custom.css"
    ]
  },
  "layout": {
    "spa": true,
    "breadcrumbs": true,
    "sidebar": {
      "collapsible": true,
      "defaultCollapsed": false
    },
    "optionsMenu": {
      "position": "header",
      "components": {
        "search": true,
        "themeSwitch": true
      }
    }
  },
  "plugins": {
    "search": {
      "enabled": true,
      "semantic": true,
      "model": "Xenova/all-MiniLM-L6-v2",
      "chunkSize": 512,
      "chunkOverlap": 64,
      "indexDir": ".docmd-search",
      "showConfidence": true,
      "showFilters": false,
      "maxResults": 10
    },
    "git": {
      "repository": "https://github.com/lopadova/claude-mem-sync",
      "branch": "main"
    },
    "seo": {
      "title": "claude-mem-sync",
      "description": "Public documentation for claude-mem-sync.",
      "image": "https://raw.githubusercontent.com/lopadova/claude-mem-sync/main/resources/github-banner-team-memory.png",
      "aiBots": true
    },
    "sitemap": {},
    "mermaid": {},
    "math": {},
    "llms": {},
    "analytics": {
      "enabled": false
    }
  },
  "navigation": [
    {
